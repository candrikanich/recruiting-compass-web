{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "framework": "nuxtjs",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-expired-invites",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-account-deletions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-suggestions",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/health-ping",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/video-health-check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/notification-prune",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/orphaned-storage-sweep",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/onboarding-nudge",
      "schedule": "0 9 * * *"
    }
  ]
}
